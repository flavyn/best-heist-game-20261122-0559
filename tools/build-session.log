+  const controls=[['WASD / ↑↓←→','MOVE'],['CLICK','WALK TO'],['SPACE','COVER'],['1 / 
2','TOOLS'],['R','RETRY'],['N','NEXT ROOM']];
+  controls.forEach(([key,label],i)=>{const 
x=42+i*198;text(c,key,x,778,11,'#d7e3df');text(c,label,x+(i===0?105:64),778,9,C.muted);});
+}
