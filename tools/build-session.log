OIN',p.x,p.y-18,9,C.gold,'Consolas, monospace','center');}
+  
s.cameras.forEach((cam,i)=>drawCamera(c,cam,i,s.jammer>0));s.guards.forEach((g,i)=>drawGuard(c,g,i,s));drawThief(c,s);
+  if(s.status==='caught'){
