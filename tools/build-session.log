+}
+function drawWorld(c,s){
+  c.save();c.translate(40,164);drawFloor(c,s);
+  c.save();c.beginPath();c.rect(24,24,872,492);c.clip();
+  for(const g of s.guards){line(c,g.points.concat([g.points[0]]).map(p=>[p.x,p.y]),'#bc985322',1,[3,8]);}
