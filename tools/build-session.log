+import {conePolygon} from './vision.js';
+import {adjacentCover} from './geometry.js';
+const C={bg:'#09121b',panel:'#101e29',line:'#2a3d49',muted:'#78909f',text:'#e0ebe9',mint:'#80ffd0',gold:'#ffda77',ambe
r:'#ffb54e',cyan:'#70ddff',red:'#ff6a79'};
+function box(c,x,y,w,h,fill,stroke,r=0){c.beginPath();c.roundRect(x,y,w,h,r);if(fill){c.fillStyle=fill;c.fill();}if(st
roke){c.strokeStyle=stroke;c.lineWidth=1;c.stroke();}}
+function text(c,label,x,y,size=12,color=C.text,font='Consolas, 
monospace',align='left'){c.fillStyle=color;c.font=`${size}px 
${font}`;c.textAlign=align;c.fillText(label,x,y);c.textAlign='left';}
+function line(c,points,color,width=1,dash=[]){c.beginPath();c.setLineDash(dash);c.strokeStyle=color;c.lineWidth=width;
points.forEach((p,i)=>i?c.lineTo(...p):c.moveTo(...p));c.stroke();c.setLineDash([]);}
+function circle(c,x,y,r,fill,stroke){c.beginPath();c.arc(x,y,r,0,Math.PI*2);if(fill){c.fillStyle=fill;c.fill();}if(str
oke){c.strokeStyle=stroke;c.lineWidth=1;c.stroke();}}
+function glow(c,color,blur,draw){c.save();c.shadowColor=color;c.shadowBlur=blur;draw();c.restore();}
+function wrapped(c,str,x,y,max,size=12,color=C.muted){let row='';for(const word of str.split(' 
')){if((row+word).length>max){text(c,row,x,y,size,color);row='';y+=19;}row+=word+' ';}text(c,row,x,y,size,color);}
+function diamond(c,x,y,size,color){c.beginPath();c.moveTo(x,y-size);c.lineTo(x+size*0.65,y);c.lineTo(x,y+size);c.lineT
o(x-size*0.65,y);c.closePath();c.fillStyle=color;c.fill();line(c,[[x,y-size],[x+size*0.23,y],[x,y+size]],'#fff4c5');}
+function drawCone(c,source,cover,color,disabled=false){
+  if(disabled)return;
+  const 
pts=conePolygon(source,cover),gradient=c.createRadialGradient(source.x,source.y,10,source.x,source.y,source.range);
+  gradient.addColorStop(0,color+'46');gradient.addColorStop(0.65,color+'25');gradient.addColorStop(1,color+'0c');
+  c.beginPath();pts.forEach((p,i)=>i?c.lineTo(p.x,p.y):c.moveTo(p.x,p.y));c.closePath();c.fillStyle=gradient;c.fill();
+  c.strokeStyle=color+'63';c.lineWidth=1;c.stroke();
+}
+function drawCover(c,r,i){
+  box(c,r.x+5,r.y+8,r.w,r.h,'#03090caa',null,4);
+  box(c,r.x,r.y,r.w,r.h,'#263947','#637987',4);
+  box(c,r.x+5,r.y+5,r.w-10,r.h-10,'#1c2c37','#3b5260',2);
+  c.save();c.beginPath();c.rect(r.x+6,r.y+6,r.w-12,r.h-12);c.clip();
+  for(let k=-r.h;k<r.w;k+=13)line(c,[[r.x+k,r.y+r.h],[r.x+k+r.h,r.y]],'#314551',1);
+  c.restore();
+  box(c,r.x+10,r.y+r.h/2-12,r.w-20,24,'#1a2b35dd',null,2);
+  text(c,r.label,r.x+r.w/2,r.y+r.h/2+3,10,'#a6b6bc','Consolas, monospace','center');
+  for(const x of [r.x+8,r.x+r.w-8])for(const y of [r.y+8,r.y+r.h-8])circle(c,x,y,2,'#8b9ca3');
+  line(c,[[r.x+9,r.y+2],[r.x+28,r.y+2]],C.mint,2);
+  text(c,String(i+1).padStart(2,'0'),r.x+8,r.y+r.h+15,9,'#4c6473');
+}
+function drawGuard(c,g,i,s){
+  const distracted=g.distract>0;
+  circle(c,g.x+2,g.y+5,13,'#0008');
+  c.save();c.translate(g.x,g.y);c.rotate(g.angle);
+  box(c,-10,-9,19,18,'#b57c39','#ffca76',4);
+  box(c,1,-5,11,10,'#f2c47b',null,3);box(c,9,-3,5,6,'#3a3b39');
+  line(c,[[-7,-7],[-7,7]],'#6d4c2c',3);c.restore();
+  circle(c,g.x,g.y,18,null,distracted?C.gold:'#ffb54e55');
+  text(c,distracted?`? ${g.distract.toFixed(1)}s`:`G${i+1}`,g.x,g.y-25,10,distracted?C.gold:'#c1a375','Consolas, 
monospace','center');
+  if(s.seenBy.includes(`PATROL ${i+1}`))text(c,'!',g.x,g.y-39,19,C.red,'Consolas, monospace','center');
+}
+function drawCamera(c,cam,i,jammed){
+  c.save();c.translate(cam.x,cam.y);circle(c,0,0,14,'#0a1a25','#376274');
+  c.rotate(cam.angle);box(c,-8,-7,20,14,jammed?'#304650':'#68bdd2','#a9eaff',3);box(c,9,-4,6,8,'#173645',C.cyan,1);c.r
estore();
+  circle(c,cam.x-5,cam.y-10,2,jammed?C.muted:C.red);
