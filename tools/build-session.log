+function box(c,x,y,w,h,fill,stroke,r=0){c.beginPath();c.roundRect(x,y,w,h,r);if(fill){c.fillStyle=fill;c.fill();}if(st
roke){c.strokeStyle=stroke;c.lineWidth=1;c.stroke();}}
+function text(c,label,x,y,size=12,color=C.text,font='Consolas, 
monospace',align='left'){c.fillStyle=color;c.font=`${size}px 
${font}`;c.textAlign=align;c.fillText(label,x,y);c.textAlign='left';}
