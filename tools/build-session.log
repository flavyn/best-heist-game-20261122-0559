+* { box-sizing: border-box; }
+body { margin: 0; min-height: 100vh; display: grid; place-items: center; overflow: hidden; }
+main { position: relative; width: min(100vw,160vh); aspect-ratio: 1.6; box-shadow: 0 0 100px #173b382b; }
+canvas { width: 100%; height: 100%; display: block; outline: none; touch-action: none; cursor: crosshair; }
+#hud { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
+#sound { position: absolute; right: 3.2%; top: 4.2%; padding: 8px 12px; border: 1px solid #31434e; background: 
#101f29; color: #91aaaF; font: 10px Consolas,monospace; letter-spacing: 1px; cursor: pointer; }
+#sound:hover, #sound:focus-visible { color: #85ffcd; border-color: #85ffcd; }
