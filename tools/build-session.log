+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+import { spawn, spawnSync } from 'node:child_process';
+import { readFileSync, readdirSync, statSync, mkdtempSync } from 'node:fs';
+import { join, dirname, relative } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { tmpdir, homedir } from 'node:os';
+import { createHash } from 'node:crypto';
+
+const require=createRequire(import.meta.url);
+let playwright;
+try { playwright=require('playwright'); }
+catch { playwright=createRequire(join(homedir(),'package.json'))('playwright'); }
+const root=dirname(dirname(fileURLToPath(import.meta.url))),port=18861,origin=`http://127.0.0.1:${port}`;
+const server=spawn(process.execPath,['serve.ts'],{cwd:root,env:{...process.env,PORT:String(port)},stdio:['ignore','pip
e','pipe'],windowsHide:true});
+let browser;
+const errors=[],outside=[],responses=[];
+const pass=line=>console.log(`AUDIT PASS ${line}`);
+const hash=bytes=>createHash('sha256').update(bytes).digest('hex');
+const manifest=dir=>{
+  const result={};
+  function walk(path){for(const e of 
readdirSync(path,{withFileTypes:true}).sort((a,b)=>a.name.localeCompare(b.name))){const 
p=join(path,e.name);if(e.isDirectory())walk(p);else 
result[relative(dir,p).replaceAll('\\','/')]=hash(readFileSync(p));}}
+  walk(dir);return result;
+};
+try {
+  await new Promise((resolve,reject)=>{server.stdout.once('data',resolve);server.once('error',reject);server.once('exi
t',code=>reject(new Error(`Server exited ${code}`)));});
+  browser=await 
playwright.chromium.launch({channel:'chrome',headless:true,args:['--disable-background-networking','--no-first-run']});
+  const context=await browser.newContext({viewport:{width:1280,height:800},deviceScaleFactor:1});
+  await context.route('**/*',route=>{
+    const url=new URL(route.request().url());
+    if(url.origin!==origin){outside.push(url.href);return route.abort();}
+    return route.continue();
+  });
+  const page=await context.newPage();
+  page.on('pageerror',e=>errors.push(e.message));
+  page.on('response',r=>{if(r.status()>=400)responses.push(`${r.status()} ${r.url()}`);});
+  await page.goto(origin);await page.waitForFunction(()=>!!window.vaultShift);
+  assert.match(await browser.version(),/\d+/);pass('real Chrome boot / 1280x800 canvas');
+  const before=await page.evaluate(()=>window.vaultShift.state.thief.x);
+  await page.keyboard.down('d');await page.waitForFunction(x=>window.vaultShift.state.thief.x>x+16,before);await 
page.keyboard.up('d');
+  assert.ok(await page.evaluate(x=>window.vaultShift.state.thief.x>x+16,before));
+  await page.keyboard.down('ArrowUp');
+  await page.waitForFunction(()=>window.vaultShift.state.thief.y<437);await page.keyboard.up('ArrowUp');
+  pass('WASD and arrow keyboard movement');
+  await page.keyboard.press('r');
